# App
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="GraphRAG Intelligence Lab"
API_V1_PREFIX=/api/v1

# PostgreSQL (Source of Truth & Outbox)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=graphrag_lab

# Qdrant (Vector & BM25 Sparse Index)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# Neo4j (Temporal Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_password

# Redis (Semantic Cache & Rate Limits)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Model Gateway & Knowledge Acquisition (LiteLLM / Gemini)
LITELLM_API_BASE=
GEMINI_API_KEY=
ACQUISITION_ENABLED=false
MAX_ACQUISITION_CALLS=3
MIN_TRUST_TO_CITE=0.7

# Evaluation data paths (blank = repo defaults under evals/)
# Tests override both to temporary directories so runs never write tracked files.
EVAL_GOLDEN_DIR=
EVAL_CANDIDATES_DIR=

# Observability (OpenTelemetry / Langfuse)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
