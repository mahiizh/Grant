# App
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="GraphRAG Intelligence Lab"
API_V1_PREFIX=/api/v1

# PostgreSQL (Source of Truth & Outbox)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=graphrag_lab

# Qdrant (Vector & BM25 Sparse Index)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# Neo4j (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_password

# Redis (Exact Response Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Model Gateway (LiteLLM / Gemini)
LITELLM_API_BASE=
GEMINI_API_KEY=

# Web grounding (graspreach). EXA_API_KEY must be exported in the backend
# process environment for in-process search; settings files are not injected.
EXA_API_KEY=
GRASPREACH_SRC_PATH=C:\projects\grasp_agent\src
GRASPREACH_PYTHON=

# Evaluation data paths (blank = repo defaults under evals/)
# Tests override both to temporary directories so runs never write tracked files.
EVAL_GOLDEN_DIR=
EVAL_CANDIDATES_DIR=

# Isolated `make eval` stores (must differ from POSTGRES_DB / QDRANT_COLLECTION)
EVAL_POSTGRES_DB=graphrag_lab_eval
EVAL_QDRANT_COLLECTION=grant_chunks_eval
EVAL_CONCURRENCY=2

# LLM response cache and per-run budget
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=.llm_cache
LLM_MAX_BUDGET_PER_RUN=0.50

# Observability (OpenTelemetry / Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
